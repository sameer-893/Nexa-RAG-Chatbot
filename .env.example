# Required API credentials. Never commit your real .env file.
OPENAI_API_KEY=replace_with_your_openai_api_key
PINECONE_API_KEY=replace_with_your_pinecone_api_key

# Redis connection URL. Use the TLS URL (rediss://) if your provider requires it.
# Example local Redis: redis://localhost:6379/0
# Example managed Redis: rediss://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/0
REDIS_URL=redis://localhost:6379/0

# Models
CHAT_MODEL=gpt-5-mini
ROUTER_MODEL=gpt-5-mini
WEB_SEARCH_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone index configuration
PINECONE_INDEX=rag-chatbot
PINECONE_NAMESPACE=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# text-embedding-3-small produces 1536-dimensional vectors.
PINECONE_DIMENSION=1536

# Retrieval and upload configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=20
CHAT_CONTEXT_MESSAGES=8

# FastAPI configuration (the current app entry point uses localhost constants).
HOST=127.0.0.1
PORT=8000

# Optional Streamlit settings
NEXA_API_URL=http://127.0.0.1:8000
NEXA_USER_ID=user1
NEXA_MAX_UPLOAD_MB=20
